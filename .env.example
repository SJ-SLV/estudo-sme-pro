# Ligação à base de dados Postgres (ex: connection string do Supabase)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Segredo para assinar os tokens de sessão do admin — troca por um valor aleatório longo
JWT_SECRET=troca-isto-por-um-segredo-forte-e-aleatorio

PORT=3000

# Origem do frontend, para restringir CORS (ex: https://estudosmepro.ao)
FRONTEND_ORIGIN=*

# Usados apenas pelo script npm run seed:admin, para criar o primeiro administrador
ADMIN_NAME=Tomás Luciano
ADMIN_CODE=0707
